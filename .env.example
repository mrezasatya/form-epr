# =====================================================================
#  Konfigurasi e-PR. Salin menjadi .env lalu sesuaikan. Restart aplikasi setelah mengubah.
#  Panduan lengkap: docs/DEPLOYMENT.md · Checklist go-live: docs/GO-LIVE.md
# =====================================================================

# ---- Database (PostgreSQL) ----
DATABASE_URL="postgresql://epr:epr@localhost:5432/epr?schema=public"
# Password DB bila memakai docker compose (service "db")
POSTGRES_PASSWORD="epr"

# ---- Aplikasi ----
# URL yang dipakai pengguna & di tautan email, mis. https://epr.perusahaan.local
APP_URL="http://localhost:3000"
# Rahasia penandatangan sesi login. WAJIB diganti (min. 32 karakter acak):  openssl rand -base64 48
SESSION_SECRET="ganti-dengan-string-acak-minimal-32-karakter-ya"
# true bila diakses lewat HTTPS (cookie hanya dikirim lewat HTTPS)
COOKIE_SECURE="false"

# ---- Login ----
# dummy = prototype: pilih akun tanpa password (JANGAN di production)
# local = NIK + password yang di-hash di database e-PR (reset oleh Admin HR)
# ldap  = NIK + password diverifikasi ke ESS / Active Directory (password tidak disimpan di e-PR)
AUTH_MODE="dummy"

# ---- LDAP / Active Directory (hanya bila AUTH_MODE=ldap) ----
# LDAP_URL="ldaps://dc01.perusahaan.local:636"
# Pola A — bind langsung (username = NIK):
# LDAP_USER_DN_TEMPLATE="{nik}@perusahaan.local"
# Pola B — cari dulu dengan akun layanan (bila username AD ≠ NIK):
# LDAP_BIND_DN="CN=svc-epr,OU=Service,DC=perusahaan,DC=local"
# LDAP_BIND_PASSWORD=""
# LDAP_SEARCH_BASE="OU=Karyawan,DC=perusahaan,DC=local"
# LDAP_SEARCH_FILTER="(employeeID={nik})"
# Bila memakai ldap:// (389), aktifkan StartTLS agar password tidak dikirim polos:
# LDAP_STARTTLS="true"
# LDAP_TLS_CA_FILE="/etc/ssl/certs/ca-perusahaan.pem"
# LDAP_TLS_REJECT_UNAUTHORIZED="true"

# ---- Email ----
# log  = email hanya dicatat di menu Notifikasi (prototype)
# smtp = dikirim lewat SMTP perusahaan (worker otomatis + percobaan ulang)
MAIL_MODE="log"
# SMTP_HOST="smtp.perusahaan.local"
# SMTP_PORT="25"            # 25 / 587 (STARTTLS) / 465 (TLS)
# SMTP_SECURE="false"       # true hanya untuk port 465
# SMTP_USER=""              # kosongkan bila relay internal tanpa login
# SMTP_PASSWORD=""
# SMTP_FROM="e-PR <epr-noreply@perusahaan.co.id>"
# SMTP_TLS_CA_FILE=""
# SMTP_TLS_REJECT_UNAUTHORIZED="true"

# ---- Pekerjaan latar (email & pengingat) ----
# Pengingat approval tertunda lebih dari N hari kerja (Spec 8)
REMINDER_BUSINESS_DAYS="3"
REMINDER_ENABLED="true"
# false bila menjalankan >1 instance dan hanya satu yang boleh menjalankan worker (opsional; worker aman paralel)
JOBS_ENABLED="true"

# ---- Penyimpanan file (memo hold/cancel, scan approval) ----
# Folder privat di server. Di Docker dipetakan ke volume epr-uploads.
STORAGE_DIR="./uploads"

# ---- Seed ----
# true hanya untuk prototype: membuat karyawan dummy. Production: false
SEED_DUMMY="true"
