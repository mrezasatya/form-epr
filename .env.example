# ---- Database (PostgreSQL) ----
# Lokal/dev. Di server internal ganti dengan host DB perusahaan.
DATABASE_URL="postgresql://epr:epr@localhost:5432/epr?schema=public"

# ---- Aplikasi ----
# URL yang dipakai di link email, mis. http://epr.perusahaan.local
APP_URL="http://localhost:3000"
# Rahasia penandatangan sesi login. WAJIB diganti (min. 32 karakter acak) di production:
#   openssl rand -base64 48
SESSION_SECRET="ganti-dengan-string-acak-minimal-32-karakter-ya"

# ---- Login ----
# dummy  = prototype: pilih akun tanpa password (JANGAN di production)
# local  = NIK + password yang di-hash di DB e-PR (opsi b)      [Fase 4]
# ldap   = NIK + password diverifikasi ke ESS/Active Directory  [Fase 4]
AUTH_MODE="dummy"

# ---- Email ----
# log  = email hanya dicatat di menu Notifikasi (prototype)
# smtp = kirim lewat SMTP perusahaan                             [Fase 4]
MAIL_MODE="log"

# ---- Seed ----
# true hanya untuk prototype: membuat karyawan dummy
SEED_DUMMY="true"

# ---- Penyimpanan file (memo hold/cancel, scan approval) ----
# Folder privat di server. Di Docker dipetakan ke volume epr-uploads.
STORAGE_DIR="./uploads"
